// Schema do Radar do Garimpo.
// Provider: Postgres (pensado para Neon/Supabase/Railway em produção e local).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Uma linha por oferta rastreada na Biblioteca de Anúncios da Meta.
model Offer {
  id         String  @id
  niche      String
  produto    String
  anunciante String
  ticket     String?

  // "sales_page" ou "quiz" — nunca "whatsapp" (regra de negócio, ver README).
  // A partir de 09/09/2026 a mineração de oferta NOVA só aceita "quiz"; "sales_page"
  // fica congelada com o catálogo já existente (só revalidação, sem entrada nova).
  destino String @default("sales_page")

  vendaUrl  String
  libraryId String @unique
  pageId    String

  collation Int?

  concorrencia   Int?
  concorrenciaEm DateTime?

  // "Alta" | "Media" | "Baixa"
  internacional String

  riscoPolitica Boolean @default(false)

  primeiraDeteccao DateTime
  descoberta       Boolean  @default(true)

  // Quando o anúncio começou a rodar de verdade no Facebook ("Veiculação
  // iniciada em", campo "start_date" da Biblioteca) — diferente de
  // primeiraDeteccao, que é quando O ROBÔ achou o anúncio (pode ser bem
  // depois do anúncio já estar rodando). Usado pra mostrar "no ar há Xd".
  veiculacaoIniciada DateTime?

  // Array de { d: "AAAA-MM-DD", c: number }, mantendo só os últimos 45 pontos.
  history Json @default("[]")

  // Quantas rodadas SEGUIDAS encontraram o mesmo problema nesta oferta. Só
  // some do catálogo quando bate o limite (ver PRUNE_STRIKES em mine.ts).
  // Existe porque uma única leitura ruim não prova nada: o Facebook bloqueia
  // o robô de vez em quando (aí a leitura falha e parecia "anúncio saiu do
  // ar") e site que carrega por JavaScript às vezes devolve só o código (aí
  // a página de venda parecia ter degradado). Nos dois casos a oferta estava
  // viva e foi apagada por engano. Volta pra zero assim que uma rodada passa
  // em tudo.
  strikes      Int     @default(0)
  strikeMotivo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([niche])
  @@map("offers")
}

// Histórico permanente de toda oferta removida do catálogo. A Offer em si é
// apagada de vez (hard delete) quando sai — este registro fica pra sempre,
// pra responder "por que essa oferta sumiu?" mesmo dias depois (o
// diagnóstico da mineração, em MetaStatus, só guarda a última rodada; a
// próxima rodada sobrescreve).
model PrunedOffer {
  id         String @id @default(cuid())
  offerId    String
  produto    String
  anunciante String
  niche      String
  vendaUrl   String
  libraryId  String
  motivo     String

  podadoEm DateTime @default(now())

  @@index([podadoEm])
  @@map("pruned_offers")
}

// Documento único (singleton) com o resumo da última rodada de mineração.
model MetaStatus {
  id            String   @id @default("singleton")
  lastRun       DateTime @default(now())
  lastRunNota   String   @default("")
  offersTracked Int      @default(0)
  novasHoje     Int      @default(0)
  podadasHoje   Int      @default(0)

  // Array de ids de ofertas que escalaram forte na rodada.
  escalations Json @default("[]")

  // Diagnóstico técnico do funil de mineração (candidatos avaliados, motivo
  // de cada rejeição, sinais de bloqueio) — não aparece no painel público,
  // só via GET /api/status, pra debugar uma rodada sem depender do log do
  // GitHub Actions (que exige login pra ver).
  diagnostico String @default("")

  // Posição na lista de keywords onde a PRÓXIMA rodada começa a varrer. Antes
  // o ponto de partida era o dia do ano, o que fazia as duas rodadas do mesmo
  // dia varrerem exatamente as mesmas keywords (a segunda só reencontrava o
  // que a primeira já tinha pego) e dois dias seguidos repetirem quase tudo.
  // Com o cursor, cada rodada continua de onde a anterior parou.
  // A partir de 09/09/2026 este cursor é só da lista de PV — Quiz tem o seu
  // próprio (keywordCursorQuiz), porque as duas listas de keywords são
  // diferentes e o Cayan pode trocar de alvo a qualquer momento (ver
  // miningTarget) sem perder o lugar em nenhuma das duas.
  keywordCursor Int @default(0)

  // "sales_page" ou "quiz" — o que a mineração de oferta NOVA busca na
  // PRÓXIMA rodada. Trocado pelo botão no painel (POST /api/mining-target),
  // não pelo robô — o robô só lê pra saber o que fazer. Revalidação do
  // catálogo já existente roda igual pros dois tipos, independente disso.
  miningTarget String @default("quiz")

  // Cursor de rotação da lista de keywords de QUIZ — ver keywordCursor acima.
  keywordCursorQuiz Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("meta_status")
}
