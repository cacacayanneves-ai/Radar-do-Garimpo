# Postgres (Neon, Supabase, Railway...) — string de conexão completa.
# No Neon: copie a "Connection string" do dashboard (pooled, com ?sslmode=require).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Chave secreta usada pelas rotas internas de escrita (/api/offers/upsert,
# /api/offers/delete, /api/status/update) e pelo job de mineração (scraper/mine.ts).
# Gere um valor aleatório forte, ex: `openssl rand -hex 32`.
SCRAPER_API_SECRET="troque-por-um-valor-aleatorio-forte"

# URL pública do site já publicado (usada pelo scraper para chamar a API em produção).
# Em desenvolvimento local, aponte para http://localhost:3000
SITE_URL="http://localhost:3000"
